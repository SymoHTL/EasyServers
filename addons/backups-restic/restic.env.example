# Copy to /etc/restic/restic.env, chmod 600, fill in.

# Where backups go. Examples:
#   local disk:        /mnt/backup/restic
#   SFTP:              sftp:user@backuphost:/backups/this-server
#   Hetzner StorageBox sftp:u123456@u123456.your-storagebox.de:/restic
#   S3 / B2:           s3:s3.eu-central-1.amazonaws.com/my-bucket/this-server
export RESTIC_REPOSITORY="sftp:user@backuphost:/backups/this-server"

# Encryption password — generate one (openssl rand -base64 32) and store a copy
# OUTSIDE this server (password manager). Lost password = lost backups.
export RESTIC_PASSWORD="CHANGE-ME"

# For S3-compatible storage also set:
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."

# What to back up (space-separated)
export BACKUP_PATHS="/etc /home /srv /var/lib/docker/volumes"

# Extra excludes (repeat --exclude)
export BACKUP_EXCLUDES="--exclude /var/lib/docker/volumes/*/cache"

# Retention
export KEEP_DAILY=7
export KEEP_WEEKLY=4
export KEEP_MONTHLY=6

# Optional: Uptime Kuma push monitor or healthchecks.io URL, pinged on success
export HEALTHCHECK_URL=""
